# Copy to .env (git-ignored) and change the passwords. Never commit .env.

# --- read by docker compose ---
POSTGRES_USER=mlops
POSTGRES_PASSWORD=change-me-postgres
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
AIRFLOW_UID=50000
AIRFLOW_SECRET=change-me-airflow-secret-at-least-32-chars

# --- read by scripts on your machine (DVC, training) ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
# MLflow 3 client: download artifacts through the tracking server, not presigned MinIO URLs
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
WAREHOUSE_URL=postgresql+psycopg2://mlops:change-me-postgres@localhost:5432/warehouse
